<style>
  :root{
    --lightest:#F5F5FF; --light:#B7D8FB; --mid:#AECBF0; --primary:#6699FB; --primary-active:#4C82E8; --primary-focus:#89B4FF;
    --ink:#1d1d1f; --body:#3c3c3c; --body-strong:#1a1a1a; --muted:#6b6b6b; --muted-soft:#9a9a9a;
    --hairline:#e6e6e6; --hairline-strong:#cccccc;
    --canvas:#ffffff; --canvas-parchment:#f5f5f7; --surface-soft:#f7f7f7; --surface-card:#fafafa;
    --on-primary:#ffffff; --on-dark:#ffffff; --on-dark-soft:#bbbbbb;
    --success:#22c55e; --warning:#f59e0b; --error:#dc2626;
    --radius-sm:8px; --radius-lg:18px; --radius-pill:9999px;
    --sp-xxs:4px; --sp-xs:8px; --sp-sm:12px; --sp-md:16px; --sp-lg:24px; --sp-xl:32px; --sp-xxl:48px;
  }
  [data-theme="dark"]{
    --ink:#f5f5f7; --body:#d1d1d6; --body-strong:#ffffff; --muted:#8e8e93; --muted-soft:#636366;
    --hairline:#2c2c2e; --hairline-strong:#3a3a3c;
    --canvas:#0e0e10; --canvas-parchment:#161618; --surface-soft:#1a1a1c; --surface-card:#1c1c1e;
    --primary:#89B4FF; --primary-active:#6699FB; --primary-focus:#a9c8ff;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--canvas); color:var(--body); font-family:'Inter',system-ui,-apple-system,sans-serif;
    -webkit-font-smoothing:antialiased; transition:background .25s ease,color .25s ease;
  }
  .deva{ font-family:'Noto Sans Devanagari','Inter',sans-serif; }

  /* ---------- loader ---------- */
  #loader{
    position:fixed; inset:0; z-index:9999; background:var(--canvas);
    display:flex; align-items:center; justify-content:center; transition:opacity .4s ease;
  }
  #loader svg circle{
    fill:none; stroke:var(--primary); stroke-width:3; stroke-linecap:round;
    stroke-dasharray:120; stroke-dashoffset:60; transform-origin:center;
    animation:spin 1.1s linear infinite;
  }
  @keyframes spin{ to{ transform:rotate(360deg); } }
  #loader.hidden{ opacity:0; pointer-events:none; }

  /* ---------- topbar ---------- */
  .topbar{
    position:sticky; top:0; z-index:50; height:64px; display:flex; align-items:center; justify-content:space-between;
    padding:0 var(--sp-lg); background:var(--canvas); border-bottom:1px solid var(--hairline);
  }
  .brand{ display:flex; align-items:center; gap:var(--sp-xs); font-weight:700; font-size:17px; color:var(--ink); }
  .brand-logo{ width:26px; height:26px; border-radius:6px; }
  .brand-logo[src=""],.brand-logo:not([src]){ display:none; }
  .top-controls{ display:flex; align-items:center; gap:var(--sp-sm); }

  .lang-toggle{ display:flex; background:var(--surface-soft); border:1px solid var(--hairline); border-radius:var(--radius-pill); padding:3px; }
  .lang-btn{
    border:none; background:transparent; color:var(--muted); font:600 13px/1 'Inter',sans-serif; letter-spacing:.2px;
    padding:8px 16px; border-radius:var(--radius-pill); cursor:pointer; transition:.18s ease;
  }
  .lang-btn.active{ background:var(--primary); color:var(--on-primary); }
  .lang-btn:not(.active):hover{ color:var(--ink); }

  .icon-btn{
    width:40px; height:40px; border-radius:var(--radius-pill); border:1px solid var(--hairline-strong);
    background:var(--canvas); color:var(--ink); display:flex; align-items:center; justify-content:center; cursor:pointer;
  }
  .icon-btn:active{ transform:scale(.93); }
  .icon-btn svg{ width:18px; height:18px; }

  /* ---------- main ---------- */
  main{ max-width:920px; margin:0 auto; padding:var(--sp-xl) var(--sp-lg) var(--sp-xxl); }

  .stats-bar{
    display:grid; grid-template-columns:repeat(5,1fr); gap:var(--sp-sm); margin-bottom:var(--sp-lg);
  }
  .stat{
    background:var(--surface-card); border:1px solid var(--hairline); border-radius:var(--radius-lg);
    padding:var(--sp-md) var(--sp-sm); text-align:center;
  }
  .stat-value{ display:block; font:700 28px/1.1 'Inter',sans-serif; color:var(--ink); letter-spacing:-.3px; }
  .stat-label{ display:block; margin-top:4px; font:700 11px/1.3 'Inter',sans-serif; letter-spacing:1.2px; text-transform:uppercase; color:var(--muted); }

  .type-wrap{ position:relative; }
  #typeArea{
    width:100%; min-height:260px; resize:none; overflow:hidden;
    background:var(--surface-card); color:var(--body-strong); border:1px solid var(--hairline-strong);
    border-radius:var(--radius-lg); padding:var(--sp-lg); font-size:19px; line-height:1.7;
    font-family:'Noto Sans Devanagari','Inter',sans-serif; outline:none; transition:border-color .15s ease;
  }
  #typeArea:focus{ border-color:var(--primary); box-shadow:0 0 0 3px rgba(102,153,251,.18); }
  .hint{ margin-top:var(--sp-xs); font-size:13px; color:var(--muted-soft); }

  .actions{ display:flex; flex-wrap:wrap; align-items:center; gap:var(--sp-sm); margin-top:var(--sp-md); }
  .btn{
    font:600 15px/1 'Inter',sans-serif; border-radius:var(--radius-pill); padding:0 22px; height:44px;
    cursor:pointer; display:inline-flex; align-items:center; justify-content:center; border:1px solid transparent;
  }
  .btn:active{ transform:scale(.95); }
  .btn-primary{ background:var(--primary); color:var(--on-primary); }
  .btn-primary:active{ background:var(--primary-active); }
  .btn-secondary{ background:var(--canvas); color:var(--ink); border-color:var(--hairline-strong); }
  .btn-text{
    background:transparent; border:none; color:var(--ink); text-transform:uppercase; font:700 13px/1 'Inter',sans-serif;
    letter-spacing:1.2px; padding:0 4px; height:auto; margin-left:auto;
  }
  .btn-text::after{ content:'›'; margin-left:4px; }

  .keymap{
    margin-top:var(--sp-lg); border:1px solid var(--hairline); border-radius:var(--radius-lg);
    background:var(--surface-card); padding:var(--sp-lg); display:none;
  }
  .keymap.open{ display:block; }
  .keymap h3{ margin:0 0 var(--sp-xs); font:700 16px/1.3 'Inter',sans-serif; color:var(--ink); }
  .keymap p{ margin:0 0 var(--sp-md); font-size:13px; color:var(--muted); }
  .kb-row{ display:flex; gap:6px; margin-bottom:6px; justify-content:center; flex-wrap:wrap; }
  .kb-key{
    flex:1 1 0; min-width:44px; max-width:64px; aspect-ratio:1/1; border:1px solid var(--hairline-strong);
    border-radius:var(--radius-sm); background:var(--canvas); display:flex; flex-direction:column;
    align-items:center; justify-content:center; font-size:11px; padding:2px;
  }
  .kb-key .top{ color:var(--primary); font-size:15px; line-height:1.1; font-weight:600; }
  .kb-key .bottom{ color:var(--ink); font-size:15px; line-height:1.1; font-weight:600; }
  .kb-legend{ display:flex; gap:var(--sp-md); margin-top:var(--sp-sm); font-size:12px; color:var(--muted); }
  .kb-legend span::before{ content:'●'; margin-right:5px; }
  .kb-legend .l1::before{ color:var(--primary); }
  .kb-legend .l2::before{ color:var(--ink); }

  footer{ background:var(--canvas-parchment); border-top:1px solid var(--hairline); padding:var(--sp-xl) var(--sp-lg); }
  .footer-cols{ max-width:920px; margin:0 auto; display:grid; grid-template-columns:repeat(3,1fr); gap:var(--sp-lg); }
  .footer-cols h4{ font:700 13px/1.3 'Inter',sans-serif; letter-spacing:1px; text-transform:uppercase; color:var(--muted); margin:0 0 var(--sp-sm); }
  .footer-cols a{ display:block; color:var(--body); text-decoration:none; font-size:14px; margin-bottom:8px; }
  .footer-cols a:hover{ color:var(--primary); }
  .footer-bottom{ max-width:920px; margin:var(--sp-lg) auto 0; padding-top:var(--sp-md); border-top:1px solid var(--hairline); font-size:12px; color:var(--muted); text-align:center; }

  @media (max-width:640px){
    .stats-bar{ grid-template-columns:repeat(3,1fr); }
    .stat-value{ font-size:20px; }
    .footer-cols{ grid-template-columns:1fr; }
    .lang-btn{ padding:8px 10px; font-size:12px; }
  }
</style>
</head>
